Redirect 301 /index https://tikcapture.live/
DirectoryIndex index.php index.html
RewriteEngine On

# Si l'URL sans slash correspond à un dossier qui contient index.html → servir directement sans rediriger
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.+[^/])$ /$1/index.html [L]

# Sitemap dynamique
RewriteRule ^sitemap\.xml$ sitemap.php?type=index [L,QSA]

# Pages créateur/vidéo → PHP (meta SEO + sert index.php)
RewriteRule ^createurs/([^/]+)/videos/([^/]+)/?$ /seo-video.php?actor=$1&video=$2 [L,QSA]
RewriteRule ^createurs/([^/]+)/?$ /seo-creator.php?id=$1 [L,QSA]

# SPA fallback — toutes les autres routes vers index.html (shell React propre)
# Sauf la racine qui utilise index.php (SSR dynamisme home page)
RewriteCond %{REQUEST_URI} ^/$
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ /index.php [L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !^/segment_page/
RewriteCond %{REQUEST_URI} !^/api/
RewriteCond %{REQUEST_URI} !^/files/
RewriteCond %{REQUEST_URI} !^/config/
RewriteCond %{REQUEST_URI} !^/helpers/
RewriteCond %{REQUEST_URI} !\.php$
RewriteRule ^ /index.html [L]

# --- OPTIMISATION CACHE ASSETS ---
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/pdf "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType application/x-javascript "access plus 1 month"
    ExpiresByType application/x-shockwave-flash "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(ico|pdf|flv|jpg|jpeg|png|gif|js|css|swf|webp|svg)$">
        Header set Cache-Control "max-age=31536000, public"
    </FilesMatch>
</IfModule>

RewriteCond %{HTTP_USER_AGENT} (Googlebot|bingbot|Twitterbot|facebookexternalhit|LinkedInBot|Slackbot|TelegramBot|WhatsApp) [NC]
RewriteRule ^createurs/([^/]+)$ /seo-creator.php?id=$1 [L,QSA]

# BEGIN cPanel-generated php ini directives, do not edit

